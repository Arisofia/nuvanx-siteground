{
  "name": "nuvanx-siteground-theme",
  "version": "1.0.0",
  "description": "NUVANX Medical Aesthetics Theme with AI Telemetry & Tailwind CSS",
  "main": "index.php",
  "scripts": {
    "build": "tailwindcss -i ./src/css/input.css -o ./dist/css/main.css --minify",
    "dev": "tailwindcss -i ./src/css/input.css -o ./dist/css/main.css --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  }
}
