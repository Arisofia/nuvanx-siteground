# Local operator template only.
# The Node scripts read process.env directly; this file is not auto-loaded.
# Export these variables in the shell or use a local dotenv loader outside CI.

# Immutable staging2 audit target.
BASE_URL=https://staging2.nuvanx.com
EXPECTED_SHA=

# Local evidence and browser configuration.
EVIDENCE_DIR=staging2-full-site-ui-audit
CHROME_BIN=

# Full-site route discovery controls.
NVX_AUDIT_REST_PER_PAGE=100
NVX_AUDIT_REST_MAX_PAGES=50
NVX_AUDIT_MIN_ROUTES=20
NVX_AUDIT_SEED_ROUTES=/,/blog/

# Optional diagnostics. Leave empty during normal execution.
NVX_CDP_DEBUG=

# GitHub Actions SSH credentials must remain repository/environment secrets:
# STAGING2_SSH_HOST
# STAGING2_SSH_PORT
# STAGING2_SSH_USER
# STAGING2_SSH_PRIVATE_KEY
# STAGING2_SSH_KNOWN_HOSTS
