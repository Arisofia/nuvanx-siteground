<?xml version="1.0"?>
<ruleset name="Nuvanx Medical Theme">
    <description>WordPress Coding Standards for Nuvanx Medical Theme</description>
    
    <!-- What to scan -->
    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    
    <!-- Show progress and sniff codes -->
    <arg value="ps"/>
    
    <!-- Check up to 8 files simultaneously -->
    <arg name="parallel" value="8"/>
    
    <!-- Use tabs for indentation -->
    <arg name="tab-width" value="4"/>
    
    <!-- Check PHP files only -->
    <arg name="extensions" value="php"/>
    
    <!-- Rules: WordPress Core -->
    <rule ref="WordPress-Core">
        <!-- Allow tabs instead of spaces -->
        <exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
    </rule>
    
    <!-- Rules: WordPress Extra -->
    <rule ref="WordPress-Extra">
        <!-- Allow tabs instead of spaces -->
        <exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
    </rule>
    
    <!-- Rules: WordPress Docs -->
    <rule ref="WordPress-Docs">
        <!-- Allow tabs instead of spaces -->
        <exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
    </rule>
    
    <!-- Enforce tab indentation -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="true"/>
        </properties>
    </rule>
    
    <rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
    
    <!-- Minimum supported WordPress version -->
    <config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
