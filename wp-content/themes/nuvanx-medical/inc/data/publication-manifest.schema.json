{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NUVANX Publication Manifest",
  "description": "Single source of truth for NUVANX public topology - represents exactly what a release allows to publish",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "nuvanx-publication-manifest",
      "description": "Schema identifier for versioning"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest (e.g., 1.0.0)"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the manifest was generated"
    },
    "source": {
      "type": "string",
      "description": "WordPress environment where the manifest was generated (e.g., staging2.nuvanx.com)"
    },
    "routes": {
      "type": "object",
      "patternProperties": {
        "^/.*": {
          "type": "object",
          "description": "Route configuration for a public URL",
          "properties": {
            "post_id": {
              "type": "integer",
              "minimum": 0,
              "description": "WordPress post ID (0 if not mapped to a post)"
            },
            "post_type": {
              "type": "string",
              "enum": ["page", "post", "attachment", "revision", "nav_menu_item", "custom_css", "customize_changeset", "oembed_cache", "user_request", "wp_block", "wp_template", "wp_template_part", "wp_global_styles", "wp_navigation", "0"],
              "description": "WordPress post type"
            },
            "slug": {
              "type": "string",
              "description": "WordPress post slug (post_name)"
            },
            "status": {
              "type": "string",
              "enum": ["publish", "draft", "pending", "private", "future", "trash", "auto-draft", "inherit", "0"],
              "description": "WordPress post status"
            },
            "renderer": {
              "type": "string",
              "description": "Template or renderer responsible for this route (e.g., front-page.php, single-post.php, page-sede.php)"
            },
            "canonical": {
              "type": "string",
              "format": "uri",
              "description": "Canonical URL for this route"
            },
            "robots": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "boolean",
                  "description": "Whether the page should be indexed"
                },
                "follow": {
                  "type": "boolean",
                  "description": "Whether links should be followed"
                },
                "archive": {
                  "type": "boolean",
                  "description": "Whether the page should be archived"
                },
                "snippet": {
                  "type": "boolean",
                  "description": "Whether snippets should be shown"
                }
              },
              "required": ["index", "follow"],
              "additionalProperties": false
            },
            "schema": {
              "type": "object",
              "description": "Expected Schema.org structured data for this route",
              "properties": {
                "group": {
                  "type": "string",
                  "enum": ["treatments", "strategic", "clinics", "clinic_hub", "other", "blog", "none"],
                  "description": "Schema group for structured data"
                },
                "id": {
                  "type": "string",
                  "description": "Schema identifier within group"
                },
                "type": {
                  "type": "string",
                  "enum": ["MedicalProcedure", "Service", "MedicalOrganization", "Physician", "FAQPage", "Organization", "WebSite", "none"],
                  "description": "Primary Schema.org type"
                },
                "context": {
                  "type": "string",
                  "enum": ["https://schema.org", "http://schema.org"],
                  "description": "Schema.org @context value"
                }
              },
              "additionalProperties": false
            },
            "seo": {
              "type": "object",
              "description": "SEO metadata configuration",
              "properties": {
                "seo_id": {
                  "type": "string",
                  "description": "SEO identifier for metadata lookup"
                },
                "route_alias": {
                  "type": "string",
                  "description": "Alternative route path for this entry"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["post_id", "post_type", "slug", "status", "robots"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema", "version", "generated_at", "source", "routes"],
  "additionalProperties": false
}