includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 0
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor
            - node_modules (?)
            - tests (?)
    ignoreErrors:
        # Ignore filter callback return issues (common in WordPress when modifying objects by reference)
        - '#Filter callback return statement is missing#'